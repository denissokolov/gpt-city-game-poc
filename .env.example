# Where the browser hits the API. Defaults to the staging deployment.
# Override to point at a local backend or a different environment.
# VITE_API_BASE_URL=http://localhost:3000

# Google OAuth 2.0 Web Client ID. Obtain it from
# https://console.cloud.google.com/apis/credentials → Create credentials →
# OAuth client ID → Web application. Add your dev origin (e.g.
# http://localhost:5173) to "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
