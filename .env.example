# Where the browser hits the API.
# In dev the default is "/api" which is proxied by Vite to VITE_API_PROXY_TARGET.
# Set this explicitly if you want to bypass the proxy (e.g. point at a local
# backend directly).
# VITE_API_BASE_URL=http://localhost:3000

# Where the Vite dev proxy forwards "/api/*" during `npm run dev`.
# Defaults to the staging deployment.
# VITE_API_PROXY_TARGET=https://gpt-city-api-5950170b319a.herokuapp.com
